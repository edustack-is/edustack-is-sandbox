// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  DIRECTOR
  PRINCIPAL
  DEPUTY
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
  ALUMNI
}

model School {
  id          String   @id @default(uuid())
  name        String
  address     String?
  contactEmail String?
  allowStudentSelfRegistration Boolean @default(false)
  requireSsoEmailMatch Boolean @default(false)
  ssoConfig   Json?
  aiConfig    Json?
  
  members     SchoolMembership[]
  classrooms  Classroom[]
  subjectTemplates SubjectTemplate[]
  subjectInstances SubjectInstance[]
  grades      Grade[]
  reportCards ReportCard[]
  attendances Attendance[]
  rooms       Room[]
  buildings   Building[]
  academicYears AcademicYear[]
  gradeLevels   GradeLevel[]
  scheduleEvents ScheduleEvent[]
  lessonTimeSlots LessonTimeSlot[]
  scheduleSubstitutions ScheduleSubstitution[]
  aiTokenUsages   AiTokenUsage[]
  curriculumVersions CurriculumVersion[]
  conversations      Conversation[]
  schoolEvents       SchoolEvent[]
  thematicPlans      ThematicPlan[]
  lessonPreparations LessonPreparation[]
  teachingMaterials  TeachingMaterial[]
  rvpCompetencies    RvpCompetency[]
  scheduleSnapshots  ScheduleSnapshot[]
  recurringEvents    RecurringEvent[]
  behaviorGrades     BehaviorGrade[]
  competencyGrades   CompetencyGrade[]
  educationalMeasures EducationalMeasure[]
  commissionExams    CommissionExam[]
  classificationDeadlines ClassificationDeadline[]
  absenceExcuses     AbsenceExcuse[]
  bulletinPosts      BulletinPost[]
  polls              Poll[]
  calendarEvents     CalendarEvent[]
  classBookEntries   ClassBookEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  firstName         String
  lastName          String
  passwordHash      String?
  avatarUrl         String?
  // role and status moved to SchoolMembership
  isSystemAdmin     Boolean     @default(false)
  emailNotificationsEnabled Boolean @default(true)
  
  invitationToken   String?
  invitationExpires DateTime?
  
  passwordResetToken   String?
  passwordResetExpires DateTime?
  
  failedLoginAttempts  Int        @default(0)
  lockedUntil          DateTime?
  
  lastLogin         DateTime?
  createdAt         DateTime    @default(now())
  deletedAt         DateTime?
  
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  identities        Identity[]
  
  schoolMemberships SchoolMembership[]
  auditLogsAsActor  AuditLog[]  @relation("AuditActor")

  // Family relations
  parentOf          ParentStudent[] @relation("ParentUser")
  childOf           ParentStudent[] @relation("StudentUser")

  // Yearly records
  studentEnrollments StudentEnrollment[]
  teacherWorkloads   TeacherWorkload[]
  staffWorkloads     StaffWorkload[]

  // Schedule substitutions created by this user
  createdSubstitutions ScheduleSubstitution[] @relation("SubstitutionCreator")

  // AI usage
  aiTokenUsages      AiTokenUsage[]

  // Messaging
  sentMessages              Message[]
  conversationParticipations ConversationParticipant[]
  notifications              Notification[]

  // Teaching plans
  teacherPlans               ThematicPlan[] @relation("TeacherPlans")
  teacherLessons             LessonPreparation[] @relation("TeacherLessons")
  uploadedMaterials          TeachingMaterial[] @relation("UploadedMaterials")

  // Schedule
  eventTeacher               RecurringEvent[] @relation("EventTeacher")

  // Grading – measures
  issuedMeasures             EducationalMeasure[] @relation("IssuedMeasures")

  // Attendance – excuses
  parentExcuses              AbsenceExcuse[] @relation("ParentExcuses")
  reviewedExcuses            AbsenceExcuse[] @relation("ReviewedExcuses")

  // Community
  bulletinPosts              BulletinPost[] @relation("BulletinAuthor")
  createdPolls               Poll[] @relation("PollAuthor")
  pollVotes                  PollVote[]
  createdCalendarEvents      CalendarEvent[] @relation("EventAuthor")
  eventRsvps                 EventRsvp[]

  // Class book
  classBookEntries           ClassBookEntry[]
  teacherSignatures          TeacherSignature[]
}

model SchoolMembership {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id])
  
  role      UserRole   @default(STUDENT)
  status    UserStatus @default(PENDING)

  workloadPercentage Float?  // Teacher workload, e.g. 1.0 = 100%

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, schoolId])
}

model ParentStudent {
  id        String   @id @default(uuid())

  parent    User     @relation("ParentUser", fields: [parentId], references: [id])
  parentId  String

  student   User     @relation("StudentUser", fields: [studentId], references: [id])
  studentId String

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model Identity {
  id          String   @id @default(uuid())
  provider    String   // 'google', 'microsoft'
  providerId  String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())

  @@unique([provider, providerId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  actorId     String
  action      String   // e.g., 'LOGIN', 'UPDATE', 'READ_SENSITIVE'
  entity      String   // the table name
  entityId    String?  // the record ID (null for system-level events)
  schoolId    String?  // null = system-level event
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
}

model Classroom {
  id              String          @id @default(uuid())
  name            String
  grade           Int
  
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id])

  students        StudentProfile[]
  homeroomTeacher TeacherProfile? @relation("HomeroomTeacher")
  scheduleEvents  ScheduleEvent[]
  enrollments     StudentEnrollment[]
}

model StudentProfile {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String     @unique
  firstName   String
  lastName    String
  rc          String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?
  grades      Grade[]
  reportCards ReportCard[]
  attendances Attendance[]
  behaviorGrades    BehaviorGrade[]
  competencyGrades  CompetencyGrade[]
  educationalMeasures EducationalMeasure[]
  commissionExams   CommissionExam[]
  absenceExcuses    AbsenceExcuse[]
}

model TeacherProfile {
  id            String     @id @default(uuid())
  user          User       @relation(fields: [userId], references: [id])
  userId        String     @unique
  degree        String?
  approbation   String?
  homeroomClass Classroom? @relation("HomeroomTeacher", fields: [homeroomClassId], references: [id])
  homeroomClassId String? @unique
  createdGrades Grade[]
  attendances   Attendance[]
  scheduleEvents ScheduleEvent[]
  substituteScheduleEvents ScheduleSubstitution[]
  competencyGrades CompetencyGrade[]
}

model SubjectTemplate {
  id              String   @id @default(uuid())
  name            String   // e.g. "Informatika"
  code            String   // e.g. "INF"
  svpDescription  String?  // Link to ŠVP document
  
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Optional: subject belongs to a specific ŠVP version
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation("VersionSubjects", fields: [curriculumVersionId], references: [id])

  instances                SubjectInstance[]
  curriculumEntries        CurriculumEntry[]
  staffSubjectAssignments  StaffSubjectAssignment[]
  thematicPlans            ThematicPlan[]
  lessonPreparations       LessonPreparation[]
  teachingMaterials        TeachingMaterial[]
  competencyMappings       CompetencyMapping[]

  @@unique([code, schoolId])
}

model SubjectInstance {
  id              String          @id @default(uuid())
  hoursPerWeek    Int

  templateId      String
  template        SubjectTemplate @relation(fields: [templateId], references: [id])

  academicYearId  String
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])

  gradeLevelId    String
  gradeLevel      GradeLevel      @relation(fields: [gradeLevelId], references: [id])

  // Link to the ŠVP version this instance was created from
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id])

  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id])

  grades          Grade[]
  reportCards      ReportCard[]
  scheduleEvents  ScheduleEvent[]
  substituteSubjectInstances ScheduleSubstitution[]
  competencyGrades CompetencyGrade[]
  commissionExams  CommissionExam[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([templateId, academicYearId, gradeLevelId])
}

model Grade {
  id              String         @id @default(uuid())
  value           String         // 1-5 or text
  weight          Float          // 0.1 - 1.0
  description     String?
  date            DateTime       @default(now())
  type            String         @default("NUMERIC") // NUMERIC | VERBAL
  verbalText      String?        // verbal evaluation text (for VERBAL type)
  category        String?        // EXAM, HOMEWORK, CLASSWORK, PROJECT, OTHER
  
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  
  studentProfile  StudentProfile @relation(fields: [studentId], references: [id])
  studentId       String
  
  subjectInstance SubjectInstance @relation(fields: [subjectInstanceId], references: [id])
  subjectInstanceId String
  
  teacherProfile  TeacherProfile @relation(fields: [teacherId], references: [id])
  teacherId       String

  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id])
  academicYearId  String?

  semester        Semester?      @relation(fields: [semesterId], references: [id])
  semesterId      String?
  
  createdAt       DateTime       @default(now())
}

model ReportCard {
  id                String          @id @default(uuid())
  finalGrade        String?         // 1-5 or "N" (nehodnocen)
  verbalEvaluation  String?         // verbal evaluation text for report
  aiPolished        Boolean         @default(false)

  studentProfile    StudentProfile  @relation(fields: [studentId], references: [id])
  studentId         String

  subjectInstance   SubjectInstance @relation(fields: [subjectInstanceId], references: [id])
  subjectInstanceId String

  semester          Semester        @relation(fields: [semesterId], references: [id])
  semesterId        String

  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([studentId, subjectInstanceId, semesterId])
}

model ScheduleEvent {
  id              String         @id @default(uuid())
  dayOfWeek       Int            // 1=Monday...5=Friday
  lessonNumber    Int            // 1-10 (lesson slot number)
  startTime       String         // "HH:mm"
  endTime         String         // "HH:mm"
  
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  
  subject         SubjectInstance @relation(fields: [subjectInstanceId], references: [id])
  subjectInstanceId String
  
  classroom       Classroom      @relation(fields: [classroomId], references: [id])
  classroomId     String
  
  teacherProfile  TeacherProfile @relation(fields: [teacherId], references: [id])
  teacherId       String

  room            Room?          @relation(fields: [roomId], references: [id])
  roomId          String?

  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id])
  academicYearId  String

  substitutions   ScheduleSubstitution[]

  classBookEntries ClassBookEntry[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([schoolId, dayOfWeek, lessonNumber, classroomId, academicYearId])
}

// ─── LESSON TIME SLOTS (zvonění) ─────────────────────────────

model LessonTimeSlot {
  id           String  @id @default(uuid())
  lessonNumber Int     // 1-10
  startTime    String  // "08:00"
  endTime      String  // "08:45"
  label        String? // "1. hodina"
  breakAfter   Int     @default(10) // přestávka v minutách
  
  schoolId     String
  school       School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, lessonNumber])
}

// ─── SCHEDULE SUBSTITUTIONS (suplování) ──────────────────────

enum SubstitutionType {
  SUBSTITUTION   // different teacher teaches
  CANCELLED      // lesson cancelled
  MERGED         // classes merged
  ROOM_CHANGE    // room change only
  SUBJECT_CHANGE // different subject
}

model ScheduleSubstitution {
  id              String           @id @default(uuid())
  date            DateTime         // specific date of substitution

  type            SubstitutionType
  note            String?

  originalEvent   ScheduleEvent    @relation(fields: [originalEventId], references: [id])
  originalEventId String

  substituteTeacher   TeacherProfile? @relation(fields: [substituteTeacherId], references: [id])
  substituteTeacherId String?

  substituteRoom    Room? @relation(fields: [substituteRoomId], references: [id])
  substituteRoomId  String?

  substituteSubject   SubjectInstance? @relation(fields: [substituteSubjectId], references: [id])
  substituteSubjectId String?

  createdBy       User             @relation("SubstitutionCreator", fields: [createdById], references: [id])
  createdById     String

  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([originalEventId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id              String           @id @default(uuid())
  date            DateTime         @default(now())
  status          AttendanceStatus
  note            String?
  lessonNumber    Int?             // link to specific lesson slot (1-10)

  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id])

  studentProfile  StudentProfile   @relation(fields: [studentId], references: [id])
  studentId       String

  teacherProfile  TeacherProfile   @relation(fields: [teacherId], references: [id])
  teacherId       String

  createdAt       DateTime         @default(now())

  @@unique([studentId, date, lessonNumber, schoolId])
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

model AbsenceExcuse {
  id           String         @id @default(uuid())
  reason       String
  dateFrom     DateTime
  dateTo       DateTime
  status       ExcuseStatus   @default(PENDING)
  parentId     String
  parent       User           @relation("ParentExcuses", fields: [parentId], references: [id])
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  schoolId     String
  school       School         @relation(fields: [schoolId], references: [id])
  reviewedById String?
  reviewedBy   User?          @relation("ReviewedExcuses", fields: [reviewedById], references: [id])
  createdAt    DateTime       @default(now())
}

model Room {
  id               String   @id @default(uuid())
  name             String
  capacity         Int      @default(30)
  floor            Int?     // floor number within building
  isComputerLab    Boolean  @default(false)
  specialEquipment Json?    // e.g. ["projector", "whiteboard", "3D printer"]

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])

  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id])

  scheduleEvents       ScheduleEvent[]
  substituteScheduleEvents ScheduleSubstitution[]
  roomSharings         RoomSharing[]
  recurringEvents      RecurringEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, schoolId])
}

model Building {
  id      String  @id @default(uuid())
  name    String          // e.g. "Budova A"
  address String?
  floors  Int     @default(1)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  rooms    Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
}

model RoomSharing {
  id                 String @id @default(uuid())
  roomId             String
  room               Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sharedWithSchoolId String

  createdAt DateTime @default(now())

  @@unique([roomId, sharedWithSchoolId])
}

model SchoolEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("OTHER") // HOLIDAY, EXAM_PERIOD, PARENT_MEETING, SCHOOL_TRIP, SPORTS_DAY, OTHER
  allDay      Boolean   @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, date])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   // e.g. "2025/2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])

  // Which ŠVP version governs this academic year (selected on creation)
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation("YearCurriculum", fields: [curriculumVersionId], references: [id])

  semesters           Semester[]
  grades              Grade[]
  studentEnrollments  StudentEnrollment[]
  teacherWorkloads    TeacherWorkload[]
  staffWorkloads      StaffWorkload[]
  subjectInstances    SubjectInstance[]
  scheduleEvents      ScheduleEvent[]
  thematicPlans       ThematicPlan[]
  scheduleSnapshots   ScheduleSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
}

model GradeLevel {
  id          String @id @default(uuid())
  name        String // e.g. "1. ročník", "Prima"
  levelNumber Int    // for sorting

  schoolId    String
  school      School @relation(fields: [schoolId], references: [id])

  studentEnrollments       StudentEnrollment[]
  subjectInstances         SubjectInstance[]
  curriculumEntries        CurriculumEntry[]
  thematicPlans            ThematicPlan[]
  teachingMaterials        TeachingMaterial[]
  competencyMappings       CompetencyMapping[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([levelNumber, schoolId])
}

model StudentEnrollment {
  id                 String       @id @default(uuid())

  student            User         @relation(fields: [studentId], references: [id])
  studentId          String

  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId     String

  gradeLevel         GradeLevel   @relation(fields: [gradeLevelId], references: [id])
  gradeLevelId       String

  classroom          Classroom?   @relation(fields: [classroomId], references: [id])
  classroomId        String?

  residentialAddress String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([studentId, academicYearId])
}

model TeacherWorkload {
  id                 String       @id @default(uuid())

  teacher            User         @relation(fields: [teacherId], references: [id])
  teacherId          String

  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId     String

  workloadPercentage Float        // e.g. 1.0 = 100%, 0.5 = 50%

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([teacherId, academicYearId])
}

// ─── STAFF WORKLOADS (versioned per academic year) ──────────

model StaffWorkload {
  id              String       @id @default(uuid())

  user            User         @relation(fields: [userId], references: [id])
  userId          String

  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  academicYearId  String

  versionLabel    String       // e.g. "září 2025", "únor 2026"
  validFrom       DateTime     // when this version becomes effective

  teachingLoad    Float        @default(0) // teaching workload 0-1.0 (100%)
  adminLoad       Float        @default(0) // administrative workload 0-1.0
  note            String?      // optional note

  subjectAssignments StaffSubjectAssignment[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, academicYearId])
}

model StaffSubjectAssignment {
  id                String        @id @default(uuid())

  staffWorkload     StaffWorkload @relation(fields: [staffWorkloadId], references: [id], onDelete: Cascade)
  staffWorkloadId   String

  subjectTemplate   SubjectTemplate @relation(fields: [subjectTemplateId], references: [id])
  subjectTemplateId String

  gradeLevelIds     Json          // string[] of GradeLevel IDs this teacher can teach
  canSubstitute     Boolean       @default(false) // can substitute for this subject

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([staffWorkloadId, subjectTemplateId])
}

// ─── SEMESTERS (pololetí) ────────────────────────────────────

model Semester {
  id            String       @id @default(uuid())
  number        Int          // 1 = first semester, 2 = second semester
  name          String       // e.g. "1. pololetí"
  startDate     DateTime
  endDate       DateTime

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  grades        Grade[]
  reportCards   ReportCard[]
  behaviorGrades       BehaviorGrade[]
  competencyGrades     CompetencyGrade[]
  educationalMeasures  EducationalMeasure[]
  commissionExams      CommissionExam[]
  classificationDeadlines ClassificationDeadline[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([academicYearId, number])
}

// ─── CURRICULUM VERSIONING (ŠVP verze) ──────────────────────
// CurriculumVersion = celoskolní verze ŠVP s platností od pololetí
// CurriculumEntry   = předmět × ročník v rámci dané verze ŠVP

model CurriculumVersion {
  id                String          @id @default(uuid())
  name              String          // e.g. "ŠVP v1.0", "ŠVP 2024"

  validFrom         DateTime        // Datum platnosti od
  validTo           DateTime?       // Datum platnosti do (null = stále platí)

  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])

  entries           CurriculumEntry[]
  subjectInstances  SubjectInstance[]
  subjectTemplates  SubjectTemplate[] @relation("VersionSubjects")
  academicYears     AcademicYear[]    @relation("YearCurriculum")

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model CurriculumEntry {
  id                    String            @id @default(uuid())
  hoursPerWeek          Int
  rvpDescription        String?           // RVP – national framework expectations
  svpApproach           String?           // ŠVP – school's teaching approach
  equipmentRequirements Json?             // e.g. ["projektor", "mikroskop"]
  needsComputerLab      Boolean           @default(false)
  gradingType           String            @default("BOTH") // NUMERIC_ONLY, VERBAL_ONLY, BOTH

  curriculumVersionId   String
  curriculumVersion     CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)

  subjectTemplateId     String
  subjectTemplate       SubjectTemplate   @relation(fields: [subjectTemplateId], references: [id])

  gradeLevelId          String
  gradeLevel            GradeLevel        @relation(fields: [gradeLevelId], references: [id])

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([curriculumVersionId, subjectTemplateId, gradeLevelId])
}

// ─── AI CONFIGURATION & BILLING ─────────────────────────────────

model SystemSettings {
  id              String   @id @default("global")
  geminiApiKey    String?
  openAiApiKey    String?
  anthropicApiKey String?

  updatedAt       DateTime @updatedAt
}

enum SecretType {
  AI
  SSO
}

model SystemSecret {
  id        String     @id @default(uuid())
  type      SecretType
  service   String     // e.g., 'GOOGLE', 'GITHUB', 'OPENAI'
  key       String     // e.g., 'API_KEY', 'CLIENT_ID', 'CLIENT_SECRET'
  value     String     // Encrypted (AES-256-GCM)
  isActive  Boolean    @default(true)
  metadata  Json?      // Optional provider-specific metadata
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([type, service, key])
}

model AiTokenUsage {
  id            String   @id @default(uuid())

  user          User     @relation(fields: [userId], references: [id])
  userId        String

  school        School?  @relation(fields: [schoolId], references: [id])
  schoolId      String?

  provider      String   // e.g. 'google', 'openai', 'anthropic'
  modelName     String   // e.g. 'gemini-1.5-pro', 'gpt-4o'
  inputTokens   Int
  outputTokens  Int
  totalTokens   Int
  promptType    String   // e.g. 'CHAT', 'SEEDING'

  createdAt     DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// MESSAGING & NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════

model Conversation {
  id          String   @id @default(uuid())
  subject     String?  // Thread subject / title
  type        String   @default("DIRECT") // DIRECT, CLASS_BROADCAST, SCHOOL_BROADCAST, GROUP

  school      School   @relation(fields: [schoolId], references: [id])
  schoolId    String

  // For CLASS_BROADCAST: the target classroom
  classroomId String?

  participants ConversationParticipant[]
  messages     Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  user           User         @relation(fields: [userId], references: [id])
  userId         String

  lastReadAt     DateTime?    // null = never read

  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String

  content        String
  flagged        Boolean      @default(false)
  flagReason     String?

  attachments    MessageAttachment[]

  createdAt      DateTime     @default(now())
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  fileSize  Int
  filePath  String
  flagged   Boolean  @default(false)
  flagReason String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  type      String   @default("MESSAGE") // MESSAGE, GRADE, SYSTEM, ATTENDANCE
  title     String
  body      String?
  linkUrl   String?  // e.g. /messages?conversation=<id>
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model GlobalConfig {
  key       String   @id
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt
}

// ─── TEACHING ─ THEMATIC PLANS ──────────────────────────────────

model ThematicPlan {
  id                String            @id @default(uuid())
  title             String
  subjectTemplateId String
  subjectTemplate   SubjectTemplate   @relation(fields: [subjectTemplateId], references: [id])
  academicYearId    String
  academicYear      AcademicYear      @relation(fields: [academicYearId], references: [id])
  gradeLevelId      String
  gradeLevel        GradeLevel        @relation(fields: [gradeLevelId], references: [id])
  teacherId         String
  teacher           User              @relation("TeacherPlans", fields: [teacherId], references: [id])
  schoolId          String
  school            School            @relation(fields: [schoolId], references: [id])

  weeks             ThematicPlanWeek[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([subjectTemplateId, academicYearId, gradeLevelId])
}

model ThematicPlanWeek {
  id              String       @id @default(uuid())
  weekNumber      Int
  topic           String
  objectives      String?      // Výstupy / cíle
  methods         String?      // Metody a formy
  resources       String?      // Pomůcky
  crossCurricular String?      // Průřezová témata
  notes           String?

  planId          String
  plan            ThematicPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekNumber])
}

// ─── TEACHING ─ LESSON PREPARATIONS ─────────────────────────────

model LessonPreparation {
  id                String          @id @default(uuid())
  title             String
  date              DateTime
  duration          Int             @default(45) // minutes
  topic             String
  objectives        String?
  activities        String?         // Průběh hodiny
  materials         String?         // Potřebné pomůcky
  homework          String?         // Zadání DÚ
  evaluation        String?         // Reflexe/hodnocení
  subjectTemplateId String
  subjectTemplate   SubjectTemplate @relation(fields: [subjectTemplateId], references: [id])
  teacherId         String
  teacher           User            @relation("TeacherLessons", fields: [teacherId], references: [id])
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ─── TEACHING ─ ELECTRONIC MATERIALS ────────────────────────────

model TeachingMaterial {
  id                String           @id @default(uuid())
  title             String
  description       String?
  url               String
  type              String           @default("OTHER") // TEXTBOOK, WORKSHEET, PRESENTATION, VIDEO, OTHER
  subjectTemplateId String?
  subjectTemplate   SubjectTemplate? @relation(fields: [subjectTemplateId], references: [id])
  gradeLevelId      String?
  gradeLevel        GradeLevel?      @relation(fields: [gradeLevelId], references: [id])
  uploadedById      String
  uploadedBy        User             @relation("UploadedMaterials", fields: [uploadedById], references: [id])
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id])

  createdAt         DateTime         @default(now())
}

// ─── RVP COMPETENCY MAPPING ─────────────────────────────────────

model RvpCompetency {
  id          String             @id @default(uuid())
  code        String
  name        String
  area        String
  description String?
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id])
  mappings          CompetencyMapping[]
  competencyGrades  CompetencyGrade[]

  @@unique([code, schoolId])
}

model CompetencyMapping {
  id                String          @id @default(uuid())
  competencyId      String
  competency        RvpCompetency   @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  subjectTemplateId String
  subjectTemplate   SubjectTemplate @relation(fields: [subjectTemplateId], references: [id])
  gradeLevelId      String
  gradeLevel        GradeLevel      @relation(fields: [gradeLevelId], references: [id])
  fulfilled         Boolean         @default(false)
  note              String?

  @@unique([competencyId, subjectTemplateId, gradeLevelId])
}

// ─── SCHEDULE SNAPSHOTS ────────────────────────────────────────

model ScheduleSnapshot {
  id             String       @id @default(uuid())
  name           String
  data           Json         // serialized events array
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime     @default(now())
}

// ─── RECURRING EVENTS (kroužky) ───────────────────────────────

model RecurringEvent {
  id          String   @id @default(uuid())
  title       String
  dayOfWeek   Int      // 1-5
  startTime   String   // "15:00"
  endTime     String   // "16:30"
  roomId      String?
  room        Room?    @relation(fields: [roomId], references: [id])
  teacherId   String?
  teacher     User?    @relation("EventTeacher", fields: [teacherId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── KLASIFIKACE – rozšíření ─────────────────────────────────

model BehaviorGrade {
  id          String         @id @default(uuid())
  grade       Int            // 1 = velmi dobré, 2 = uspokojivé, 3 = neuspokojivé
  note        String?
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  semesterId  String
  semester    Semester       @relation(fields: [semesterId], references: [id])
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@unique([studentId, semesterId])
}

model CompetencyGrade {
  id                String          @id @default(uuid())
  level             Int             // 1-4 (1=začíná, 4=ovládá)
  note              String?
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id])
  competencyId      String
  competency        RvpCompetency   @relation(fields: [competencyId], references: [id])
  subjectInstanceId String
  subjectInstance   SubjectInstance @relation(fields: [subjectInstanceId], references: [id])
  semesterId        String
  semester          Semester        @relation(fields: [semesterId], references: [id])
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])
  teacherId         String
  teacher           TeacherProfile  @relation(fields: [teacherId], references: [id])
  createdAt         DateTime        @default(now())
  @@unique([studentId, competencyId, subjectInstanceId, semesterId])
}

enum MeasureType {
  PRAISE
  REPRIMAND
  CLASS_REPRIMAND
  PRINCIPAL_REPRIMAND
}

model EducationalMeasure {
  id          String         @id @default(uuid())
  type        MeasureType
  reason      String
  date        DateTime       @default(now())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  issuedById  String
  issuedBy    User           @relation("IssuedMeasures", fields: [issuedById], references: [id])
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id])
  semesterId  String?
  semester    Semester?      @relation(fields: [semesterId], references: [id])
  createdAt   DateTime       @default(now())
}

model CommissionExam {
  id                String         @id @default(uuid())
  date              DateTime
  originalGrade     String
  newGrade          String?
  note              String?
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id])
  subjectInstanceId String
  subjectInstance   SubjectInstance @relation(fields: [subjectInstanceId], references: [id])
  semesterId        String
  semester          Semester       @relation(fields: [semesterId], references: [id])
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ClassificationDeadline {
  id          String   @id @default(uuid())
  deadline    DateTime
  isLocked    Boolean  @default(false)
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([semesterId, schoolId])
}

// ─── COMMUNITY ──────────────────────────────────────────────

model BulletinPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation("BulletinAuthor", fields: [authorId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Poll {
  id          String       @id @default(uuid())
  question    String
  multiSelect Boolean      @default(false)
  endsAt      DateTime?
  authorId    String
  author      User         @relation("PollAuthor", fields: [authorId], references: [id])
  schoolId    String
  school      School       @relation(fields: [schoolId], references: [id])
  options     PollOption[]
  createdAt   DateTime     @default(now())
}

model PollOption {
  id       String     @id @default(uuid())
  text     String
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  @@unique([userId, optionId])
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

model CalendarEvent {
  id          String      @id @default(uuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  authorId    String
  author      User        @relation("EventAuthor", fields: [authorId], references: [id])
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id])
  rsvps       EventRsvp[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model EventRsvp {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    RsvpStatus
  createdAt DateTime     @default(now())
  @@unique([userId, eventId])
}

// ─── CLASS BOOK ─────────────────────────────────────────────

model ClassBookEntry {
  id               String          @id @default(uuid())
  date             DateTime
  lessonNumber     Int             // 1-10
  topic            String?         // probírané učivo
  notes            String?         // poznámky k hodině
  absentCount      Int?            // počet nepřítomných

  schoolId         String
  school           School          @relation(fields: [schoolId], references: [id])

  classroomId      String

  teacherId        String
  teacher          User            @relation(fields: [teacherId], references: [id])

  scheduleEventId  String?
  scheduleEvent    ScheduleEvent?  @relation(fields: [scheduleEventId], references: [id])

  subjectName      String?         // cached subject name for quick display

  signature        TeacherSignature?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([schoolId, classroomId, date, lessonNumber])
}

model TeacherSignature {
  id               String         @id @default(uuid())
  classBookEntryId String         @unique
  classBookEntry   ClassBookEntry @relation(fields: [classBookEntryId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          User           @relation(fields: [teacherId], references: [id])
  signedAt         DateTime       @default(now())
  ipAddress        String?
}
