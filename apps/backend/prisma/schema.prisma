// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  message   String
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
}

model Classroom {
  id              String          @id @default(uuid())
  name            String
  grade           Int
  students        StudentProfile[]
  homeroomTeacher TeacherProfile? @relation("HomeroomTeacher")
  scheduleEvents  ScheduleEvent[]
}

model StudentProfile {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String     @unique
  firstName   String
  lastName    String
  rc          String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?
  grades      Grade[]
}

model TeacherProfile {
  id            String     @id @default(uuid())
  user          User       @relation(fields: [userId], references: [id])
  userId        String     @unique
  degree        String?
  approbation   String?
  homeroomClass Classroom? @relation("HomeroomTeacher", fields: [homeroomClassId], references: [id])
  homeroomClassId String? @unique
  createdGrades Grade[]
  scheduleEvents ScheduleEvent[]
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  grades    Grade[]
  scheduleEvents ScheduleEvent[]
}

model Grade {
  id              String         @id @default(uuid())
  value           String         // 1-5 or text
  weight          Float          // 0.1 - 1.0
  description     String?
  date            DateTime       @default(now())
  
  studentProfile  StudentProfile @relation(fields: [studentId], references: [id])
  studentId       String
  
  subject         Subject        @relation(fields: [subjectId], references: [id])
  subjectId       String
  
  teacherProfile  TeacherProfile @relation(fields: [teacherId], references: [id])
  teacherId       String
  
  createdAt       DateTime       @default(now())
}

model ScheduleEvent {
  id              String         @id @default(uuid())
  dayOfWeek       Int            // 0=Sunday, 1=Monday...
  startTime       String         // "HH:mm"
  endTime         String         // "HH:mm"
  
  subject         Subject        @relation(fields: [subjectId], references: [id])
  subjectId       String
  
  classroom       Classroom      @relation(fields: [classroomId], references: [id])
  classroomId     String
  
  teacherProfile  TeacherProfile @relation(fields: [teacherId], references: [id])
  teacherId       String
}
