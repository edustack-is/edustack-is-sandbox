# ─── POVINNÉ ─────────────────────────────────────────────
# JWT signing key (vygenerujte: openssl rand -base64 64)
JWT_SECRET=

# AES-256 encryption key pro šifrování secrets (vygenerujte: openssl rand -base64 32)
ENCRYPTION_KEY=

# ─── DATABÁZE ────────────────────────────────────────────
# Výchozí hodnoty odpovídají docker-compose.yml
POSTGRES_USER=student
POSTGRES_PASSWORD=student
POSTGRES_DB=skola_db

# ─── VOLITELNÉ ───────────────────────────────────────────
# Setup token – chrání /api/init/* při nasazení (openssl rand -hex 32)
# SETUP_TOKEN=

# CORS – povolený frontend origin (výchozí: http://localhost:5173)
# CORS_ORIGIN=https://app.example.com

# Automatické zálohy – denně ve 2:00, posledních 7
# AUTO_BACKUP=true

# ─── POZNÁMKY ────────────────────────────────────────────
# AI klíče (Gemini, OpenAI, Anthropic) se konfigurují v UI:
#   System Admin → Nastavení → AI
#
# SSO (Google, Microsoft) se konfiguruje v UI:
#   System Admin → Nastavení → SSO
#
# SMTP: Docker Compose spouští MailDev automaticky (port 1025/1080).
# Pro produkci nastavte v .env:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USER=...
#   SMTP_PASS=...
#   MAIL_FROM=noreply@example.com
