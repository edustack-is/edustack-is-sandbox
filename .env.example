# ─── EduStack IS – Consolidated Configuration ──────────────────

# [SECURITY] JWT signing key (generate with: openssl rand -base64 64)
JWT_SECRET=

# [SECURITY] AES-256 encryption key for secret fields (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# [LOGIN] Set to true to show demo users on login screen
ENABLE_LOGIN_HELPER=true
# Allowed roles for login helper (comma separated)
LOGIN_HELPER_ROLES=SYSTEM_ADMIN,ADMIN,TEACHER,DEPUTY,PRINCIPAL,STUDENT,PARENT

# ─── DATABASE ───────────────────────────────────────────────
# Note: App auto-detects Wrangler DB, this is only for Prisma CLI tools.
DB_ADAPTER=sqlite
DATABASE_URL=file:./dev.db

# ─── EMAIL (SMTP) ───────────────────────────────────────────
# Locally: 'npm run dev' starts MailDev automatically on port 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@edustack.local
SMTP_USER=
SMTP_PASS=

# ─── SERVICES ───────────────────────────────────────────────
# Backend Port
PORT=3000
# MCP Server Port
MCP_PORT=3001

# URLs
CORS_ORIGIN=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
MCP_SERVER_URL=http://127.0.0.1:3001/sse

# ─── MCP SERVER HARDENING ──────────────────────────────────
# Bind address for the MCP server. Default is loopback only (127.0.0.1)
# so it's unreachable from the network. Set to 0.0.0.0 only when fronted
# by a reverse proxy AND when MCP_AUTH_TOKEN is set.
MCP_HOST=127.0.0.1
# Shared bearer token. When set, /sse, /message, and /v1/chat/completions
# require `Authorization: Bearer <token>`. The backend forwards this token
# automatically. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Comma-separated CORS allow-list. Leave empty to disable CORS entirely
# (correct for loopback-only deployments).
MCP_CORS_ORIGIN=

# ─── AI PROVIDERS ──────────────────────────────────────────
# Base URL for the OpenCode provider (OpenAI-compatible). Defaults to the
# local MCP server. In production this MUST be https://.
OPENCODE_BASE_URL=http://127.0.0.1:3001/v1

# ─── OPTIONAL: CLOUDFLARE R2 BACKUP ─────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edustack-backups

# ─── DEVELOPMENT ────────────────────────────────────────────
AUTO_SEED=true
NODE_ENV=development
DEMO_PASSWORD="Demo1234!"
