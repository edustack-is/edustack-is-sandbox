# Security – JWT signing key (REQUIRED, generate with: openssl rand -base64 64)
JWT_SECRET=

# Security – AES-256 encryption key for secrets at rest (REQUIRED, generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Security – Setup token (OPTIONAL, protects /api/init/* during deployment, generate with: openssl rand -hex 32)
# SETUP_TOKEN=

# CORS – Allowed frontend origin(s), comma-separated (default: http://localhost:5173)
# CORS_ORIGIN=https://app.example.com

# Database Configuration
POSTGRES_USER=student
POSTGRES_PASSWORD=student
POSTGRES_DB=skola_db

# AI Configuration
GOOGLE_AI_API_KEY=your_api_key_here

# SMTP Configuration (MailDev)
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@edustack.local
