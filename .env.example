# ─── POVINNÉ ──────────────────────────────────────────────
# JWT signing key (vygenerujte: openssl rand -base64 64)
JWT_SECRET=

# AES-256 encryption key pro šifrování secrets (vygenerujte: openssl rand -base64 32)
ENCRYPTION_KEY=

# ─── DATABÁZE (SQLite / Cloudflare Local) ──────────────────
# Ponechte prázdné pro AUTO-DETEKCI souboru v .wrangler složce.
# Pokud auto-detekce selže, nastavte cestu k .sqlite souboru ručně.
DB_ADAPTER=sqlite
DATABASE_URL=

# ─── E-MAILY (SMTP) ────────────────────────────────────────
# Lokálně: 'npm run dev' spustí MailDev automaticky.
# SMTP server běží na 1025 a web UI na 1081 (pro vyhnutí se konfliktu s Dockerem)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@edustack.local

# ─── OSTATNÍ ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
MCP_SERVER_URL=http://localhost:3001/sse
AUTO_SEED=true

# ─── CLOUDFLARE R2 BACKUP STORAGE (Volitelné) ──────────────
# Ponechte prázdné pro lokální zálohování na disk.
# R2_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edustack-backups
