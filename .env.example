# ─── POVINNÉ (Společné pro oba režimy) ──────────────────────
# JWT signing key (vygenerujte: openssl rand -base64 64)
JWT_SECRET=

# AES-256 encryption key pro šifrování secrets (vygenerujte: openssl rand -base64 32)
ENCRYPTION_KEY=

# ─── REŽIM A: DOCKER + POSTGRESQL (Výchozí) ─────────────────
# Nastavte tyto hodnoty pro 'docker-compose up'
DB_ADAPTER=native
DATABASE_URL=postgresql://student:student@localhost:5432/skola_db

# Konfigurace pro Postgres kontejner
POSTGRES_USER=student
POSTGRES_PASSWORD=student
POSTGRES_DB=skola_db

# ─── REŽIM B: LOKÁLNÍ VÝVOJ / CLOUDFLARE (SQLite) ───────────
# Odkomentujte tyto řádky pro běh bez Dockeru s SQLite
# DB_ADAPTER=sqlite
# DATABASE_URL=file:./data/dev.db

# ─── E-MAILY (SMTP) ────────────────────────────────────────
# Lokálně bez Dockeru: npx maildev (spustí SMTP na 1025 a web na 1080)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@edustack.local

# ─── OSTATNÍ ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
MCP_SERVER_URL=http://localhost:3001/sse
AUTO_SEED=true

# ─── POZNÁMKY ──────────────────────────────────────────────
# 1. Lokální MailDev bez Dockeru:
#    Spusťte v samostatném terminálu: npx maildev
#
# 2. Inicializace DB (Postgres):
#    npm run db:generate && npm run db:push
#
# 3. Inicializace DB (SQLite):
#    npm run db:generate -- --schema=./apps/backend/prisma/schema_sqlite.prisma
#    npm run db:push -- --schema=./apps/backend/prisma/schema_sqlite.prisma
