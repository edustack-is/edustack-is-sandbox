# ─── POVINNÉ ──────────────────────────────────────────────
# JWT signing key (vygenerujte: openssl rand -base64 64)
JWT_SECRET=

# AES-256 encryption key pro šifrování secrets (vygenerujte: openssl rand -base64 32)
ENCRYPTION_KEY=

# ─── REŽIM: LOKÁLNÍ VÝVOJ BEZ DOCKERU (SQLite) ──────────────
# Používá lokální soubor v adresáři data/
DB_ADAPTER=sqlite
DATABASE_URL=file:./data/dev.db

# ─── E-MAILY (SMTP) ────────────────────────────────────────
# Lokálně bez Dockeru: spusťte 'npx maildev' v samostatném okně
# SMTP server poběží na 1025 a web UI na 1080
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@edustack.local

# ─── OSTATNÍ ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
MCP_SERVER_URL=http://localhost:3001/sse
AUTO_SEED=true

# ─── POZNÁMKA K INICIALIZACI ───────────────────────────────
# Pro SQLite (lokální běh) inicializujte databázi příkazem:
# npm run db:generate -- --schema=./apps/backend/prisma/schema_sqlite.prisma
# npm run db:push -- --schema=./apps/backend/prisma/schema_sqlite.prisma
