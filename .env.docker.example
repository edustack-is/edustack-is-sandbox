# ─── POVINNÉ ──────────────────────────────────────────────
# JWT signing key (vygenerujte: openssl rand -base64 64)
JWT_SECRET=

# AES-256 encryption key pro šifrování secrets (vygenerujte: openssl rand -base64 32)
ENCRYPTION_KEY=

# ─── REŽIM: DOCKER + POSTGRESQL ────────────────────────────
# Výchozí hodnoty pro 'docker-compose up'
DB_ADAPTER=native
DATABASE_URL=postgresql://student:student@postgres:5432/skola_db

# Konfigurace pro Postgres kontejner (shodné s DATABASE_URL)
POSTGRES_USER=student
POSTGRES_PASSWORD=student
POSTGRES_DB=skola_db

# ─── E-MAILY (SMTP) ────────────────────────────────────────
# Docker Compose automaticky spouští MailDev jako službu 'maildev'
SMTP_HOST=maildev
SMTP_PORT=1025
MAIL_FROM=noreply@edustack.local

# ─── OSTATNÍ ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
MCP_SERVER_URL=http://mcp-server:3001/sse
AUTO_SEED=true
